{
  "id": "step5-upscale",
  "meta": {
    "mode": "step5",
    "title": "放大变清晰（图像超分占位）",
    "placeholders": ["PROMPT", "SEED", "IMAGE_NAME"],
    "notes": "默认用 SDXL img2img 轻度重绘作占位。建议在私有镜像中替换为专用 Video Upscale / SeedVR 等工作流，保持 SaveImage 或 SaveVideo 输出。"
  },
  "prompt": {
    "4": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": { "ckpt_name": "sd_xl_base_1.0.safetensors" }
    },
    "10": {
      "class_type": "LoadImage",
      "inputs": { "image": "{{IMAGE_NAME}}" }
    },
    "11": {
      "class_type": "VAEEncode",
      "inputs": { "pixels": ["10", 0], "vae": ["4", 2] }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{PROMPT}}, sharp, high detail, clear",
        "clip": ["4", 1]
      }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "blurry, low quality, artifacts",
        "clip": ["4", 1]
      }
    },
    "8": {
      "class_type": "KSampler",
      "inputs": {
        "seed": "{{SEED}}",
        "steps": 20,
        "cfg": 4,
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 0.35,
        "model": ["4", 0],
        "positive": ["6", 0],
        "negative": ["7", 0],
        "latent_image": ["11", 0]
      }
    },
    "9": {
      "class_type": "VAEDecode",
      "inputs": { "samples": ["8", 0], "vae": ["4", 2] }
    },
    "12": {
      "class_type": "SaveImage",
      "inputs": { "filename_prefix": "manju_step5_upscale", "images": ["9", 0] }
    }
  }
}
