{
  "id": "step3-scene-look",
  "meta": {
    "mode": "step3",
    "title": "场景图/定妆照（SDXL）",
    "placeholders": ["PROMPT", "NEGATIVE", "SEED", "WIDTH", "HEIGHT", "STEPS", "CFG"],
    "notes": "在私有镜像中可替换为 Flux / 角色一致性节点；保持 SaveImage 输出即可被桌面端读取。"
  },
  "prompt": {
    "4": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": { "ckpt_name": "sd_xl_base_1.0.safetensors" }
    },
    "5": {
      "class_type": "EmptyLatentImage",
      "inputs": { "width": "{{WIDTH}}", "height": "{{HEIGHT}}", "batch_size": 1 }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "{{PROMPT}}", "clip": ["4", 1] }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "{{NEGATIVE}}", "clip": ["4", 1] }
    },
    "8": {
      "class_type": "KSampler",
      "inputs": {
        "seed": "{{SEED}}",
        "steps": "{{STEPS}}",
        "cfg": "{{CFG}}",
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 1,
        "model": ["4", 0],
        "positive": ["6", 0],
        "negative": ["7", 0],
        "latent_image": ["5", 0]
      }
    },
    "9": {
      "class_type": "VAEDecode",
      "inputs": { "samples": ["8", 0], "vae": ["4", 2] }
    },
    "10": {
      "class_type": "SaveImage",
      "inputs": { "filename_prefix": "manju_step3", "images": ["9", 0] }
    }
  }
}
